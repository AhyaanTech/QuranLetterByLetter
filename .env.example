# Copy to .env and customize for your environment.
# .env is gitignored — never commit real secrets.

# PostgreSQL password (default: quran — fine for local dev)
POSTGRES_PASSWORD=quran

# DSN used by load_to_postgres.py and pytest
POSTGRES_DSN=postgresql://quran:quran@localhost:5432/quran

# Hasura admin secret (change for any non-local deployment)
HASURA_ADMIN_SECRET=hasura_dev_secret
